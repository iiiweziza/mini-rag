APP_NAME=mini-rag
APP_VERSION=0.0.1

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_API_URL= # optional

COHERE_API_KEY=YOUR_COHERE_API_KEY

POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=101101
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_MAIN_DATABASE=minirag

GENERATION_BACKEND=OPENAI
EMBEDDING_BACKEND=OPENAI

GENERATION_MODEL_ID=gpt-3.5-turbo
EMBEDDING_MODEL_ID=text-embedding-3-small
EMBEDDING_MODEL_SIZE=1536

INPUT_DAFAULT_MAX_CHARACTERS=1000
GENERATION_DAFAULT_MAX_TOKENS=1000
GENERATION_DAFAULT_TEMPERATURE=0.1

VECTOR_DB_BACKEND=PGVECTOR
VECTOR_DB_PATH=/assets/database/default
VECTOR_DB_DISTANCE_METHOD=COSINE

FILE_ALLOWED_TYPES="['text/plain', 'application/pdf']"
FILE_MAX_SIZE=5
FILE_DEFAULT_CHUNK_SIZE=524288

PRIMARY_LANG=en
DEFAULT_LANG=en

# JWT Settings
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080  # 7 days
